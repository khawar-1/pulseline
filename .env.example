# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DeepSeek — platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# Optional. Defaults to deepseek-chat. deepseek-reasoner will not work here:
# it does not support function calling.
# PULSELINE_MODEL=deepseek-chat

# Optional. Traces of the agent's planning and subagent delegation, which are
# the clearest view into what the harness is actually doing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=pulseline
